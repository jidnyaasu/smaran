---
const {title="स्मरण — Prayer Library"}=Astro.props;
import "../styles/global.css";
---
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Serif+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet"></head><body><div class="site-shell"><header class="topbar"><a class="brand" href="/"><span class="brand-mark">ॐ</span><span><strong>स्मरण</strong><small>Prayer Library</small></span></a><nav><a href="/#library">Library</a><a href="/#festivals">Festivals</a><a href="/#favorites">Favorites</a></nav><button class="icon-btn" id="theme">☾</button></header><slot/><footer><div><span class="brand-mark small">ॐ</span> स्मरण</div><p>A small prayer library, lovingly collected.</p><span>॥ सर्वे भवन्तु सुखिनः ॥</span></footer></div><script>if(localStorage.getItem("smaran-dark")==="true")document.body.classList.add("dark");document.querySelector("#theme")?.addEventListener("click",()=>{document.body.classList.toggle("dark");localStorage.setItem("smaran-dark",document.body.classList.contains("dark"))})</script></body></html>