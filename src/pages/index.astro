---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const groups=['stotra','aarti','mantra-shloka'];
const all=(await Promise.all(groups.map(async c=>(await getCollection(c)).map(e=>({...e.data,collection:c,slug:e.slug}))))).flat();
---
<BaseLayout>
<main>
<section class="hero"><div class="hero-aura"></div><div class="hero-copy">
<div class="eyebrow">॥ श्री गणेशाय नमः ॥</div><h1>नित्यं<br><em>स्मरणम्</em></h1>
<p>A collection of prayers, stotras, mantras, aartis and shlokas — made for everyday reading and festivals.</p>
<div class="search-wrap"><span>⌕</span><input id="q" placeholder="Search stotras, gods, festivals..." autocomplete="off"><kbd>/</kbd></div>
<div class="chips"><button data-q="गणेश">गणेश</button><button data-q="शिव">शिव</button><button data-q="विष्णु">विष्णु</button><button data-q="देवी">देवी</button><button data-q="हनुमान">हनुमान</button></div>
</div><div class="hero-lamp">🪔</div></section>

<section id="library" class="section"><div class="section-head"><div><span class="section-kicker">Explore</span><h2>The library</h2></div><span id="count"></span></div>
<div id="sections" class="library-sections">
<a class="library-card" href="/library/stotra"><span class="library-icon">🕉️</span><span class="card-type">स्तोत्र</span><h3>Stotra</h3><p>Sacred hymns & prayers</p><b>Explore →</b></a>
<a class="library-card" href="/library/aarti"><span class="library-icon">🪔</span><span class="card-type">आरती</span><h3>Aarti</h3><p>Devotional songs & aartis</p><b>Explore →</b></a>
<a class="library-card" href="/library/mantra-shloka"><span class="library-icon">📿</span><span class="card-type">मंत्र • श्लोक</span><h3>Mantra & Shloka</h3><p>Mantras, verses & daily prayers</p><b>Explore →</b></a>
</div>
<div id="results" class="search-results" hidden><div class="search-heading">Search results <strong id="label"></strong></div><div id="cards" class="cards"></div><div id="empty" class="empty" hidden>No prayers found. Try another term.</div></div>
</section>

<section class="daily-card"><div class="daily-symbol">ॐ</div><div><span class="section-kicker">A little for today</span><h2>वक्रतुण्ड महाकाय</h2><p class="devanagari">वक्रतुण्ड महाकाय सूर्यकोटि समप्रभः ।<br>निर्विघ्नं कुरु मे देव सर्वकार्येषु सर्वदा ॥</p><p class="translation">A traditional prayer for an auspicious, obstacle-free beginning.</p></div></section>
<section id="festivals" class="section compact"><div class="section-head"><div><span class="section-kicker">Seasonal</span><h2>Festivals & occasions</h2></div></div><div class="festival-grid"><article>🪔<h3>दिवाळी</h3><p>Search the library for Diwali prayers.</p></article><article>🌺<h3>नवरात्रि</h3><p>Devi stotras & prayers.</p></article><article>🐘<h3>गणेश चतुर्थी</h3><p>Ganesh mantras & aartis.</p></article><article>🔱<h3>महाशिवरात्री</h3><p>Shiva mantras & stotras.</p></article></div></section>
<section id="favorites" class="section compact"><div class="section-head"><div><span class="section-kicker">Saved on this device</span><h2>Your favorites</h2></div></div><div id="favs" class="favorites-list"></div></section>
</main>
<script define:vars={{all}}>
const input=document.querySelector('#q'), sections=document.querySelector('#sections'),results=document.querySelector('#results'),cards=document.querySelector('#cards'),empty=document.querySelector('#empty'),label=document.querySelector('#label'),count=document.querySelector('#count'),items=all;
function match(i,q){return [i.title,i.subtitle,i.type,...i.deity,...i.festivals,...i.aliases,...i.language].join(' ').toLowerCase().includes(q.toLowerCase())}
function render(q){const list=q?items.filter(i=>match(i,q)):[];sections.hidden=!!q;results.hidden=!q;label.textContent=q?`“${q}”`:'';count.textContent=q?`${list.length} result${list.length===1?'':'s'}`:'';cards.innerHTML=list.map(i=>`<a class="card" href="/library/${i.collection}/${i.slug}"><span class="card-icon">${i.icon}</span><span class="card-type">${i.type}</span><h3>${i.title}</h3><p>${i.subtitle}</p><div class="card-bottom"><small>Read →</small><span>♡</span></div></a>`).join('');empty.hidden=!!list.length}
input.oninput=()=>render(input.value.trim());document.querySelectorAll('[data-q]').forEach(b=>b.onclick=()=>{input.value=b.dataset.q;render(b.dataset.q);document.querySelector('#library').scrollIntoView({behavior:'smooth'})});document.addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement!==input){e.preventDefault();input.focus()}});
document.querySelector('#favs').innerHTML='<span style="color:var(--muted);font-size:13px">Favorites will be available once you save prayers from their reading pages.</span>';
</script>
</BaseLayout>
