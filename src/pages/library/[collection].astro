---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){return ['stotra','aarti','mantra-shloka'].map(collection=>({params:{collection}}))}
const {collection}=Astro.params;const entries=await getCollection(collection);
const names={stotra:['Stotra','स्तोत्र','Sacred hymns & prayers'],aarti:['Aarti','आरती','Devotional songs & aartis'],'mantra-shloka':['Mantra & Shloka','मंत्र • श्लोक','Mantras, verses & daily prayers']}[collection];
---
<BaseLayout><main><section class="library-hero"><a class="back" href="/">← Back to library</a><span class="section-kicker">{names[1]}</span><h1>{names[0]}</h1><p>{names[2]}</p></section><section class="section"><div class="cards">{entries.map(e=><a class="card" href={`/library/${collection}/${e.slug}`}><span class="card-icon">{e.data.icon}</span><span class="card-type">{e.data.type}</span><h3>{e.data.title}</h3><p>{e.data.subtitle}</p><div class="card-bottom"><small>Read →</small><span>♡</span></div></a>)}</div></section></main></BaseLayout>